# === Gateway PIX (AssetPay) ===
# Chaves da sua conta AssetPay. A autenticação é Basic base64(secret:public),
# por isso as DUAS são necessárias. Configure no painel do Netlify
# (Site settings -> Environment variables), NUNCA no código/repositório.
ASSETPAY_SECRET_KEY=
ASSETPAY_PUBLIC_KEY=

# Base da API (opcional — este é o padrão).
ASSETPAY_API_URL=https://api.assetpay.com.br/api/v1

# Protege o endpoint de webhook. Gere uma string aleatória; o webhook é
# registrado como postbackUrl .../api/webhook?token=ESSE_VALOR.
WEBHOOK_SECRET=

# === Painel /admin ===
# Senha de acesso ao painel de métricas. Sem ela o painel fica FECHADO.
ADMIN_PASSWORD=

# === Notificação de venda no Telegram (opcional) ===
# Crie um bot no @BotFather, pegue o token; mande /start pro bot e pegue seu
# chat id em https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Porta do servidor local (dev). Opcional.
PORT=3000

# Sem as chaves da AssetPay, o backend roda em modo STUB (PIX simulado que
# aprova sozinho) — útil para desenvolver sem cobrar de verdade.
